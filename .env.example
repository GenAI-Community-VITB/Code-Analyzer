# Copy to ".env" in the project root (same folder as this file).

# --- Gemini (required for LLM evaluations; static analysis runs without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Clone analysis ----------------------------------------------------------
# CLONE_WORK_DIR=temp_repos
# MAX_FILES_CLONE_ANALYSIS=120
# GIT_CLONE_TIMEOUT_SECONDS=600
# LLM_BATCH_SIZE=8
# LLM_CONCURRENT_BATCHES=2

# --- Output ------------------------------------------------------------------
# REPORTS_DIR=reports
