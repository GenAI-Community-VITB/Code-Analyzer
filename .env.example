# BERT scoring endpoint (required)
BERT_API_URL=https://your-bert-scorer.example.com/score

# Mistral API for LLM scoring + prompt rewriting (required)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Improve pipeline tuning
TRASH_THRESHOLD=80
TARGET_SCORE=90
MAX_IMPROVE_ITERS=3
